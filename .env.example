# ==============================================================================
# DARKVENCE — Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# --- Server & Runtime ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# --- Authentication & Session Security ---
# Change JWT_SECRET to a strong random string in staging/production (e.g. openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# --- Initial Administrator Credentials (Fallback Default) ---
# Used if no admin exists in the database store or during initial bootstrap.
# You can also run 'npm run create:admin' to create your personal admin account interactively!
ADMIN_EMAIL=admin@darkvence.com
ADMIN_PASSWORD=darkvence2026!
INITIAL_ADMIN_EMAIL=admin@darkvence.com
INITIAL_ADMIN_PASSWORD=darkvence2026!

# --- Database Configuration (MongoDB Atlas) ---
# Primary persistent database connection string.
# Replace YOUR_USERNAME, YOUR_PASSWORD, and YOUR_CLUSTER with your MongoDB Atlas cluster details.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/darkvence?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/darkvence?retryWrites=true&w=majority

# --- Cloudinary Media Storage (Optional) ---
# If Cloudinary credentials are omitted, uploaded media files automatically fall back
# to the local server disk directory at 'public/uploads/' and are served via '/uploads/*'.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
