# Dependencies
node_modules/

# Production build artifacts
build/
dist/
dist-ssr/
*.local

# Environment variables & secrets (CRITICAL: never commit credentials)
.env*
!.env.example

# Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
coverage/

# OS metadata
.DS_Store
Thumbs.db

# User uploaded dynamic media assets (preserve directory via .gitkeep)
public/uploads/*
!public/uploads/.gitkeep

# MongoDB local persistent database directory & migration backups
.mongo_data/
src/server/db/backups/
migration_report*.json
